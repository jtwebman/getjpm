---
// How jpm lays packages out on disk (jpm's docs/how-it-works.md): the content-addressed store,
// the global virtual store's entries, and the links a project's node_modules makes to them. The
// diagram plays in four steps that match the list beside it; it rests on the last step without
// script or under reduced motion.
import { docs, link, useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const steps = [1, 2, 3, 4] as const;
const chips = ['3fa1', '9c07', 'e4b2', '71d8', '0b5e', 'c6a3'];
// Chip centers and where each one's hardlink lands: three files of debug, three of ms.
const hardlinks = [
  [40, 60],
  [96, 100],
  [152, 140],
  [208, 248],
  [264, 280],
  [320, 316],
];
---

<section id="storage" class="section alt feature flip" aria-labelledby="storage-title">
  <div class="container feature-grid">
    <div class="feature-text">
      <p class="eyebrow">{t('storage.eyebrow')}</p>
      <h2 id="storage-title" class="section-title">{t('storage.title')}</h2>
      <p class="lead">{t('storage.lead')}</p>
      <ol class="steps" data-steps>
        {
          steps.map((n) => (
            <li data-step-item={n}>
              <h3>{t(`storage.step${n}.title`)}</h3>
              <p set:html={t(`storage.step${n}.body`)} />
            </li>
          ))
        }
      </ol>
    </div>

    <div class="visual">
      <figure class="diagram-card">
        <svg class="diagram" data-diagram data-step="4" viewBox="0 0 360 436" role="img" aria-label={t('storage.diagramLabel')}>
          <g class="frame">
            <rect x="1" y="1" width="358" height="100" rx="12"></rect>
            <text x="16" y="24" class="title">~/.jpm/store</text>
            <text x="344" y="24" class="sub" text-anchor="end">{t('storage.svg.files')}</text>
          </g>
          {
            chips.map((c, i) => (
              <g data-s="1" style={`--i:${i}`}>
                <rect class="chip" x={16 + i * 56} y="44" width="48" height="40" rx="6" />
                <path class="chip-fold" d={`M${16 + i * 56 + 10} 56h20M${16 + i * 56 + 10} 62h28M${16 + i * 56 + 10} 68h16`} />
                <text class="chip-text" x={40 + i * 56} y="79" text-anchor="middle">
                  {c}
                </text>
              </g>
            ))
          }

          {hardlinks.map(([x1, x2], i) => <path data-s="2" class="draw hard" style={`--i:${i}`} pathLength="1" d={`M${x1} 86C${x1} 145 ${x2} 145 ${x2} 202`} />)}
          <text data-s="2" x="180" y="132" class="label" text-anchor="middle">{t('storage.svg.hardlinks')}</text>

          <g class="frame">
            <rect x="1" y="150" width="358" height="150" rx="12"></rect>
            <text x="16" y="173" class="title">~/.jpm/store/v1/links</text>
            <text x="344" y="173" class="sub" text-anchor="end">{t('storage.svg.entries')}</text>
          </g>
          <g data-s="2" class="entry">
            <rect x="16" y="204" width="186" height="82" rx="8"></rect>
            <text x="28" y="224" class="entry-name">debug@4.4.3-q7Lr2KaX</text>
            <text x="28" y="248" class="row">node_modules/debug</text>
            <text x="28" y="272" class="row">node_modules/ms</text>
          </g>
          <g data-s="2" class="entry">
            <rect x="218" y="204" width="126" height="82" rx="8"></rect>
            <text x="230" y="224" class="entry-name">ms@2.1.3</text>
            <text x="230" y="248" class="row">node_modules/ms</text>
          </g>
          <path data-s="2" class="soft" d="M128 268C176 268 182 248 214 248M208 244l6 4-6 4"></path>

          <g class="frame">
            <rect x="1" y="350" width="172" height="84" rx="12"></rect>
            <text x="16" y="373" class="title">app-one/</text>
          </g>
          <g class="frame">
            <rect x="187" y="350" width="172" height="84" rx="12"></rect>
            <text x="202" y="373" class="title">app-two/</text>
          </g>
          <g data-s="3" class="pill">
            <rect x="12" y="388" width="150" height="30" rx="6"></rect>
            <text x="22" y="407" class="row">node_modules/debug</text>
          </g>
          <path data-s="3" class="soft" d="M124 388C124 336 100 330 100 292M95 298l5-6 5 6"></path>
          <g data-s="4" class="pill">
            <rect x="198" y="388" width="150" height="30" rx="6"></rect>
            <text x="208" y="407" class="row">node_modules/debug</text>
          </g>
          <path data-s="4" class="soft" d="M306 388C306 330 160 336 160 292M155 298l5-6 5 6"></path>
          <text data-s="3" x="180" y="332" class="label" text-anchor="middle">{t('storage.svg.links')}</text>
        </svg>
        <button type="button" class="play button" data-play hidden data-label-pause={t('storage.pause')} data-label-play={t('storage.play')}>
          <svg class="i-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"></rect><rect x="14" y="5" width="4" height="14" rx="1"></rect></svg>
          <svg class="i-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L8.5 4.64A1 1 0 0 0 7 5.5Z"></path></svg>
          <span data-play-label>{t('storage.pause')}</span>
        </button>
      </figure>

      <div class="per-project">
        <h3>{t('storage.perProject.title')}</h3>
        <p set:html={t('storage.perProject.body')} />
        <pre class="terminal"><code>node_modules/next -&gt; .jpm/next@16.0.0-…/node_modules/next
node_modules/.jpm/next@16.0.0-…/node_modules/next/
node_modules/.jpm/react@19.2.0/node_modules/react/</code></pre>
      </div>
      <p class="note" set:html={t('storage.more', { link: link(docs('how-it-works'), 'docs/how-it-works.md') })} />
    </div>
  </div>
</section>

<script>
  const STEP_MS = 2200;
  const HOLD_MS = 4200;

  for (const svg of document.querySelectorAll<SVGSVGElement>('[data-diagram]')) {
    const section = svg.closest('section')!;
    const items = [...section.querySelectorAll<HTMLElement>('[data-step-item]')];
    const button = section.querySelector<HTMLButtonElement>('[data-play]')!;
    const label = button.querySelector<HTMLElement>('[data-play-label]')!;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) continue;

    let step = 0;
    let timer: number | undefined;
    let playing = true;
    let visible = false;

    const show = (n: number) => {
      step = n;
      svg.dataset.step = String(n);
      for (const li of items) {
        if (Number(li.dataset.stepItem) === n) li.setAttribute('aria-current', 'step');
        else li.removeAttribute('aria-current');
      }
    };
    const tick = () => {
      const next = step >= 4 ? 0 : step + 1;
      show(next);
      timer = window.setTimeout(tick, next === 4 ? HOLD_MS : next === 0 ? 700 : STEP_MS);
    };
    const run = () => {
      window.clearTimeout(timer);
      if (playing && visible) timer = window.setTimeout(tick, step === 0 ? 300 : STEP_MS);
    };

    button.hidden = false;
    button.addEventListener('click', () => {
      playing = !playing;
      button.dataset.paused = String(!playing);
      label.textContent = (playing ? button.dataset.labelPause : button.dataset.labelPlay) ?? '';
      // Paused, the diagram shows everything.
      if (!playing) show(4);
      run();
    });

    show(0);
    new IntersectionObserver(
      ([e]) => {
        visible = e.isIntersecting;
        run();
      },
      { threshold: 0.3 },
    ).observe(svg);
  }
</script>

<style>
  @layer components {
    .steps {
      list-style: none;
      padding: 0;
      counter-reset: step;
      display: grid;
      gap: var(--size-2);
      margin-block-start: var(--size-5);
      & li {
        counter-increment: step;
        position: relative;
        padding: var(--size-3) var(--size-3) var(--size-3) 3.25rem;
        border-radius: var(--radius-3);
        border: 1px solid transparent;
        transition: background-color 0.3s var(--ease-2), border-color 0.3s var(--ease-2);
        &::before {
          content: counter(step);
          position: absolute;
          inset-inline-start: var(--size-3);
          inset-block-start: var(--size-3);
          inline-size: 1.75rem;
          block-size: 1.75rem;
          display: grid;
          place-items: center;
          border-radius: 50%;
          background: var(--surface-3);
          color: var(--text-1);
          font-weight: var(--font-weight-7);
          font-size: 0.875rem;
          transition: background-color 0.3s var(--ease-2), color 0.3s var(--ease-2);
        }
        &[aria-current] {
          background: var(--accent-soft);
          border-color: var(--accent);
          &::before {
            background: var(--accent);
            color: var(--accent-ink);
          }
        }
      }
      & h3 {
        font-size: var(--font-size-2);
        margin-block-end: var(--size-1);
      }
      & p {
        color: var(--text-2);
        font-size: 0.9375rem;
      }
    }

    .visual {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--size-5);
    }
    .diagram-card {
      position: relative;
      background: var(--surface-2);
      border: 1px solid var(--border);
      border-radius: var(--radius-3);
      padding: var(--size-4);
      display: grid;
      gap: var(--size-3);
      justify-items: center;
    }
    .diagram {
      inline-size: 100%;
      max-inline-size: 30rem;
      block-size: auto;
      overflow: visible;
      font-family: var(--font-mono);

      & .frame rect {
        fill: var(--surface-raised);
        stroke: var(--border-strong);
        stroke-width: 1;
      }
      & .title {
        font-size: 13px;
        font-weight: 700;
        fill: var(--text-1);
      }
      & .sub {
        font-family: var(--font-sans);
        font-size: 11.5px;
        fill: var(--text-2);
      }
      & .chip {
        fill: var(--accent-soft);
        stroke: var(--accent);
      }
      & .chip-fold {
        stroke: var(--accent);
        stroke-width: 1.5;
        stroke-linecap: round;
        opacity: 0.55;
      }
      & .chip-text {
        font-size: 10.5px;
        fill: var(--text-1);
      }
      & .entry rect,
      & .pill rect {
        fill: var(--surface-2);
        stroke: var(--border-strong);
      }
      & .entry-name {
        font-size: 11.5px;
        font-weight: 700;
        fill: var(--accent-strong);
      }
      & .row {
        font-size: 10.5px;
        fill: var(--text-1);
      }
      & .hard {
        fill: none;
        stroke: var(--accent);
        stroke-width: 1.5;
      }
      & .soft {
        fill: none;
        stroke: var(--text-2);
        stroke-width: 1.5;
        stroke-dasharray: 4 3;
        stroke-linecap: round;
        stroke-linejoin: round;
      }
      & .label {
        font-family: var(--font-sans);
        font-size: 11.5px;
        font-weight: 600;
        fill: var(--text-2);
        paint-order: stroke;
        stroke: var(--surface-2);
        stroke-width: 5px;
        stroke-linejoin: round;
      }
    }

    /* Steps: what belongs to step n shows from step n on. */
    @media (prefers-reduced-motion: no-preference) {
      .diagram [data-s] {
        transition: opacity 0.5s var(--ease-2) calc(var(--i, 0) * 70ms);
      }
      .diagram .draw {
        stroke-dasharray: 1;
        transition:
          stroke-dashoffset 0.9s var(--ease-out-3) calc(var(--i, 0) * 70ms),
          opacity 0.2s;
      }
    }
    .diagram {
      & [data-s] {
        opacity: 0;
      }
      & .draw {
        stroke-dashoffset: 1;
      }
      &[data-step='1'] [data-s='1'],
      &[data-step='2'] :is([data-s='1'], [data-s='2']),
      &[data-step='3'] :is([data-s='1'], [data-s='2'], [data-s='3']),
      &[data-step='4'] [data-s] {
        opacity: 1;
        &.draw {
          stroke-dashoffset: 0;
        }
      }
    }

    .play {
      min-block-size: 2.25rem;
      padding-inline: var(--size-3);
      font-size: 0.8125rem;
      & .i-play {
        display: none;
      }
      &[data-paused='true'] {
        & .i-play {
          display: block;
        }
        & .i-pause {
          display: none;
        }
      }
    }

    .per-project {
      display: grid;
      gap: var(--size-2);
      & h3 {
        font-size: var(--font-size-2);
      }
      & p {
        color: var(--text-2);
      }
      & pre {
        font-size: 0.75rem;
        line-height: var(--font-lineheight-4);
      }
    }
  }
</style>
