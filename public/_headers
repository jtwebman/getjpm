# Cloudflare Pages response headers. The page's Content-Security-Policy is a <meta> Astro writes
# with a hash of each inline script; frame-ancestors can only be set here.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
  Strict-Transport-Security: max-age=31536000

# Hashed file names: safe to keep for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
