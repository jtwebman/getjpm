---
import BlogPost from '../../components/BlogPost.astro';
import { defaultLocale } from '../../i18n';
import { posts, slugOf } from '../../blog';

export async function getStaticPaths() {
  return (await posts()).map((post) => ({ params: { slug: slugOf(post) }, props: { post } }));
}
---

<BlogPost locale={defaultLocale} post={Astro.props.post} />
