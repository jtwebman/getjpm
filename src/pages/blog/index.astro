---
import Base from '../../layouts/Base.astro';
import { defaultLocale } from '../../i18n';
import { posts, postHref, formatDate } from '../../blog';

const list = await posts();
---

<Base locale={defaultLocale} page="blog/" translated={false} title="Blog · jpm" description="Posts about jpm, a fast, small package manager for JavaScript written in Rust.">
  <section class="container blog">
    <h1 class="section-title">Blog</h1>
    <p class="note"><a href="/blog/rss.xml">RSS feed</a></p>
    {list.length === 0 && <p>No posts yet.</p>}
    <ol>
      {
        list.map((p) => (
          <li>
            <time datetime={p.data.date.toISOString().slice(0, 10)}>{formatDate(p.data.date)}</time>
            <h2>
              <a href={postHref(p.id)}>{p.data.title}</a>
            </h2>
            <p>{p.data.description}</p>
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<style>
  @layer components {
    .blog {
      max-inline-size: 46rem;
      padding-block: var(--size-fluid-5);
    }
    ol {
      list-style: none;
      padding: 0;
      margin-block-start: var(--size-7);
      display: grid;
      gap: var(--size-7);
    }
    time {
      font-size: var(--font-size-0);
      color: var(--text-2);
    }
    h2 {
      font-size: var(--font-size-4);
      margin-block: var(--size-1) var(--size-2);
      & a {
        color: var(--text-1);
        text-decoration: none;
        &:hover {
          color: var(--link);
          text-decoration: underline;
        }
      }
    }
    li p {
      color: var(--text-2);
    }
  }
</style>
