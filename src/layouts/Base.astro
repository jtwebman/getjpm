---
// The shell every page uses: head and meta, theme, header nav and footer. A page passes its
// locale and, for pages beyond the home page, its path within the locale (e.g. 'docs/install/').
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { locales, localeHref, useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  /** The page's path inside a locale, '' for the home page. */
  page?: string;
  title?: string;
  description?: string;
}

const { locale, page = '', title, description } = Astro.props;
const t = useTranslations(locale);
const site = Astro.site ?? new URL('https://getjpm.sh');
const pageTitle = title ?? t('meta.title');
const pageDescription = description ?? t('meta.description');
const canonical = new URL(localeHref(locale, page), site).href;
const ogImage = new URL('/og.png', site).href;
const repo = 'https://github.com/jtwebman/jpm';
// What search engines show about jpm: free, MIT-licensed developer software, with its source and
// where to get it. A data block, never run, so the page's script policy does not apply to it.
const structured = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'jpm',
  description: pageDescription,
  url: site.href,
  image: ogImage,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Linux, macOS, Windows',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  license: 'https://opensource.org/licenses/MIT',
  downloadUrl: `${repo}/releases/latest`,
  sameAs: [repo],
  author: { '@type': 'Person', name: 'JT Turner', url: 'https://github.com/jtwebman' },
  inLanguage: locale.code,
};
---

<!doctype html>
<html lang={locale.code}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    {locales.map((l) => <link rel="alternate" hreflang={l.code} href={new URL(localeHref(l, page), site).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(localeHref(locales[0], page), site).href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta name="author" content="JT Turner" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0f12" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="jpm" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="jpm: fast, small, secure by default" />
    <meta property="og:locale" content={locale.og} />
    {locales.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={l.og} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="jpm: fast, small, secure by default" />
    <script type="application/ld+json" set:html={JSON.stringify(structured)} />
    <!-- The chosen theme, set before the first paint so a dark page never flashes light. -->
    <script is:inline>
      try {
        var theme = localStorage.getItem('jpm-theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t('nav.skip')}</a>
    <Header locale={locale} page={page} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>

<style>
  @layer components {
    .skip-link {
      position: absolute;
      inset-inline-start: var(--size-3);
      inset-block-start: -10rem;
      z-index: 100;
      padding: var(--size-2) var(--size-3);
      background: var(--accent);
      color: var(--accent-ink);
      border-radius: var(--radius-2);
      font-weight: var(--font-weight-6);
      &:focus {
        inset-block-start: var(--size-2);
      }
    }
    main:focus {
      outline: none;
    }
  }
</style>
