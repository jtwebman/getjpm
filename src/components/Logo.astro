---
// jpm's mark: a lowercase j in a rounded square. The favicon (public/favicon.svg) is the same
// drawing in fixed colors.
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: cls } = Astro.props;
---

<svg class:list={['logo', cls]} width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <rect width="32" height="32" rx="8" class="logo-bg"></rect>
  <circle cx="18.5" cy="8.75" r="2.25" class="logo-ink-fill"></circle>
  <path d="M18.5 13.5v9.25a4.25 4.25 0 0 1-4.25 4.25H11.5" class="logo-ink-stroke" fill="none" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>

<style>
  @layer components {
    .logo-bg {
      fill: var(--accent);
    }
    .logo-ink-fill {
      fill: var(--accent-ink);
    }
    .logo-ink-stroke {
      stroke: var(--accent-ink);
    }
  }
</style>
