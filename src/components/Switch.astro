---
// Moving a project to jpm, as jpm's docs/migrating.md describes it: the lockfile it has is
// imported into jpm.lock with the same versions.
import { docs, link, useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
// Plain text badges: no other project's logo or colors.
const sources = [
  ['npm', 'package-lock.json'],
  ['pnpm', 'pnpm-lock.yaml'],
  ['yarn', 'yarn.lock'],
  ['bun', 'bun.lock'],
];
const facts = ['switch.carried', 'switch.yarn', 'switch.untouched', 'switch.ci', 'switch.setup'] as const;
---

<section id="start" class="section alt feature flip" aria-labelledby="start-title">
  <div class="container feature-grid">
    <div class="feature-text">
      <p class="eyebrow">{t('switch.eyebrow')}</p>
      <h2 id="start-title" class="section-title">{t('switch.title')}</h2>
      <p class="lead" set:html={t('switch.lead')} />
      <ul class="checks">
        {facts.map((k) => <li set:html={t(k)} />)}
      </ul>
      <p class="note" set:html={t('switch.more', { link: link(docs('migrating'), 'docs/migrating.md') })} />
    </div>

    <div class="visual">
      <figure class="flow" data-flow role="img" aria-label={t('switch.diagramLabel')}>
        <ul class="sources">
          {
            sources.map(([tool, file], i) => (
              <li style={`--i:${i}`}>
                <span class="tool">{tool}</span>
                <code>{file}</code>
              </li>
            ))
          }
        </ul>
        <svg class="arrow" viewBox="0 0 64 24" aria-hidden="true">
          <path class="shaft" d="M4 12h50" pathLength="1"></path>
          <path class="head" d="M46 4l10 8-10 8"></path>
        </svg>
        <div class="target">
          <span class="tool jpm">jpm</span>
          <code class="file">jpm.lock</code>
          <pre><code>jpm-lock 2
package @babel/core@7.29.7
  integrity sha512-…
  dep @babel/generator 7.29.8</code></pre>
        </div>
      </figure>
      <pre class="terminal"><code><span class="prompt">$ </span>cd your-project
<span class="prompt">$ </span>jpm install   <span class="comment"># {t('switch.cmd')}</span></code></pre>
    </div>
  </div>
</section>

<script>
  import { animateOnView } from '../scripts/bars';
  for (const el of document.querySelectorAll<HTMLElement>('[data-flow]')) animateOnView(el);
</script>

<style>
  @layer components {
    .checks {
      list-style: none;
      padding: 0;
      display: grid;
      gap: var(--size-3);
      & li {
        position: relative;
        padding-inline-start: 1.75rem;
        color: var(--text-2);
        &::before {
          content: '';
          position: absolute;
          inset-inline-start: 0.25rem;
          inset-block-start: 0.45em;
          inline-size: 0.75rem;
          block-size: 0.4rem;
          border-inline-start: 2px solid var(--accent);
          border-block-end: 2px solid var(--accent);
          rotate: -45deg;
        }
      }
    }
    .visual {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--size-4);
      align-content: start;
    }
    .flow {
      container-type: inline-size;
      background: var(--surface-raised);
      border: 1px solid var(--border);
      border-radius: var(--radius-3);
      padding: var(--size-5);
      box-shadow: var(--shadow);
    }
    .flow {
      display: grid;
      gap: var(--size-3);
      justify-items: center;
    }
    .sources {
      list-style: none;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--size-2);
      inline-size: 100%;
      & li {
        display: grid;
        gap: 2px;
        padding: var(--size-2) var(--size-3);
        border: 1px solid var(--border);
        border-radius: var(--radius-2);
        background: var(--surface-2);
      }
      & code {
        background: none;
        padding: 0;
        font-size: 0.75rem;
        color: var(--text-2);
        overflow-wrap: anywhere;
      }
    }
    .tool {
      font-family: var(--font-mono);
      font-weight: var(--font-weight-7);
      font-size: 0.9375rem;
    }
    .arrow {
      inline-size: 3rem;
      rotate: 90deg;
      fill: none;
      stroke: var(--accent);
      stroke-width: 3;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    .target {
      inline-size: 100%;
      display: grid;
      gap: 2px;
      padding: var(--size-3) var(--size-4);
      border: 2px solid var(--accent);
      border-radius: var(--radius-3);
      background: var(--accent-soft);
      & .jpm {
        color: var(--accent-strong);
      }
      & .file {
        background: none;
        padding: 0;
        font-weight: var(--font-weight-7);
      }
      & pre {
        margin-block-start: var(--size-2);
        font-size: 0.75rem;
        color: var(--text-2);
        overflow-x: auto;
      }
    }
    @container (width >= 34rem) {
      .flow {
        grid-template-columns: minmax(0, 1fr) auto minmax(0, 1.1fr);
        align-items: center;
      }
      .sources {
        grid-template-columns: minmax(0, 1fr);
      }
      .arrow {
        rotate: none;
      }
    }

    .terminal {
      white-space: pre-wrap;
      font-size: 0.875rem;
    }

    /* Plays once in view: the four lockfiles come in, the arrow draws, jpm.lock appears. */
    .flow:global(.js-anim) {
      & .sources li {
        opacity: 0;
        translate: -8px 0;
      }
      & .shaft {
        stroke-dasharray: 1;
        stroke-dashoffset: 1;
      }
      & .head,
      & .target {
        opacity: 0;
      }
      & .target {
        scale: 0.96;
      }
    }
    .flow:global(.js-anim.is-in) {
      & .sources li {
        animation: flow-in 0.4s var(--ease-out-3) calc(var(--i) * 120ms) forwards;
      }
      & .shaft {
        animation: flow-draw 0.5s var(--ease-out-3) 0.6s forwards;
      }
      & .head {
        animation: flow-show 0.2s var(--ease-2) 1s forwards;
      }
      & .target {
        animation: flow-pop 0.45s var(--ease-out-3) 1.1s forwards;
      }
    }
    @keyframes flow-in {
      to {
        opacity: 1;
        translate: 0 0;
      }
    }
    @keyframes flow-draw {
      to {
        stroke-dashoffset: 0;
      }
    }
    @keyframes flow-show {
      to {
        opacity: 1;
      }
    }
    @keyframes flow-pop {
      to {
        opacity: 1;
        scale: 1;
      }
    }
  }
</style>
